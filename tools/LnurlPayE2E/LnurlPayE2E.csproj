<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BTCPayServer.Plugins.LnurlPayBackend\BTCPayServer.Plugins.LnurlPayBackend.csproj" />
    <PackageReference Include="NBitcoin" Version="10.0.7" />
    <PackageReference Include="BTCPayServer.Lightning.All" Version="1.7.6" />
  </ItemGroup>

  <!-- Keep BTCPayServer references from putting static web assets into the output -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
    </ProjectReference>
  </ItemDefinitionGroup>

</Project>
